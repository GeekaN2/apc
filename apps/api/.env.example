# Local PGlite: postgres://postgres:postgres@127.0.0.1:5432/postgres
# Server: postgres://gpt@%2Fvar%2Frun%2Fpostgresql/apc (socket, peer authentication)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Public URL of the API, used for OAuth callbacks
BETTER_AUTH_URL=http://127.0.0.1:4000
# Random string of at least 32 characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Frontend origins allowed to send cookies, comma separated
WEB_ORIGINS=http://127.0.0.1:5173

# Discord application, https://discord.com/developers/applications
# Redirect URL: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The old calculator's API takes 4000 on the server
PORT=4100
HOST=127.0.0.1
